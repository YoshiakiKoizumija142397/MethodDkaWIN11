{
  "name": "methoddka-app",
  "version": "1.0.0",
  "description": "MethodDka 50-digit version with i18n support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Yoshiaki Koizumi",
  "license": "MIT",

  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.methoddka.app",
    "productName": "MethodDka",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "help/",
        "to": "help",
        "filter": ["**/*"]
      },
      {
        "from": "locales/",
        "to": "locales",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
